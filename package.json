{
  "name": "camel-studio",
  "productName": "Camel Studio",
  "version": "0.5.0",
  "description": "Desktop IDE for Spring Boot + Apache Camel integrations: design, run, deploy, monitor.",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "catalog": "node scripts/build-catalog.mjs",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist": "electron-vite build && electron-builder --mac --win",
    "vscode": "electron-vite build && node scripts/build-vscode.mjs"
  },
  "camelStudio": {
    "camelVersion": "4.22.2"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.100.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.2",
    "@xmldom/xmldom": "^0.9.12",
    "@xyflow/react": "^12.12.1",
    "codemirror": "^6.0.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "immer": "^11.2.9",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "yaml": "^2.9.1",
    "zustand": "^5.1.0"
  },
  "author": "Camel Studio"
}
